{
  "name": "gizi-masakan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm data:validate && next build && node scripts/postbuild.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:conservation": "vitest run tests/conservation",
    "test:gaps": "vitest run tests/gaps",
    "test:state": "vitest run tests/url tests/simpan tests/cari",
    "fdc:fetch": "tsx scripts/fdc-pipeline.ts fetch",
    "fdc:build": "tsx scripts/fdc-pipeline.ts build",
    "factors:fetch": "tsx scripts/factors-pipeline.ts fetch",
    "factors:build": "tsx scripts/factors-pipeline.ts build",
    "data:validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
